# Copy this file to .env.local (dev) or set these in your hosting
# environment (production). Nothing here is required for a local checkout
# to run — every value has a development-safe default — but ADMIN_PASSWORD
# and API_KEY should always be set explicitly before going live.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Standard Next.js flag. Set automatically by `next build`/`next start`;
# you shouldn't need to set this yourself.
# NODE_ENV=production

# Where the SQLite database file lives. Relative paths resolve from the
# project root. Defaults to data/dashboard.db. On most hosts this should
# point at a persistent volume — a fresh filesystem on every deploy means a
# fresh (empty) database.
DATABASE_PATH=

# ---------------------------------------------------------------------------
# Bootstrap administrator
# ---------------------------------------------------------------------------
# Created automatically the first time the app starts against an empty
# database. Change the password immediately after first sign-in, or set a
# strong one here before that first boot — additional accounts (with
# Administrator / Supervisor / Staff roles) are then created from the
# Users screen, not from environment variables.

ADMIN_EMAIL=admin@mobitouch.demo
ADMIN_NAME=Administrator
ADMIN_PASSWORD=Demo@2026

# ---------------------------------------------------------------------------
# External integrations
# ---------------------------------------------------------------------------
# Shared secret external callers (the municipal website's Contact / Report
# an Issue forms, or an n8n workflow) send as the `x-api-key` header when
# POSTing to /api/requests. If set, it is registered automatically as the
# first integration key on a brand-new database. Additional keys — and
# revocation — are managed from Settings once the app is running; this
# variable only seeds the very first one. Set the SAME value as
# DASHBOARD_API_KEY on the website.
API_KEY=

# ---------------------------------------------------------------------------
# Demo data
# ---------------------------------------------------------------------------
# Whether to import data/db.json (if present) into a brand-new database on
# first boot. Defaults to true outside production and false in production,
# so this normally never needs to be set explicitly.
# SEED_DEMO_DATA=false
